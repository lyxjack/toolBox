{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "TaskDAG",
    "type": "object",
    "required": [
        "requirementRef",
        "createdAt",
        "tasks"
    ],
    "properties": {
        "requirementRef": {
            "type": "string",
            "pattern": "^REQ-"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        },
        "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "description",
                    "dependencies",
                    "verificationCriteria"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^T\\d+"
                    },
                    "description": {
                        "type": "string"
                    },
                    "skillRef": {
                        "type": "string",
                        "description": "Skill name from _rag_index"
                    },
                    "skillPath": {
                        "type": "string",
                        "description": "Path to SKILL.md"
                    },
                    "dependencies": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "estimatedTokens": {
                        "type": "integer"
                    },
                    "verificationCriteria": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "status": {
                        "enum": [
                            "pending",
                            "in_progress",
                            "done",
                            "blocked"
                        ]
                    }
                }
            }
        }
    }
}