{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Handoff",
    "description": "Standard handoff schema for task delegation between roles. Every task must be wrapped in this schema before passing to the next role.",
    "type": "object",
    "required": [
        "task_id",
        "parent_request_id",
        "title",
        "objective",
        "scope_in",
        "scope_out",
        "constraints",
        "expected_outputs",
        "acceptance_checks",
        "evidence_required"
    ],
    "properties": {
        "task_id": {
            "type": "string",
            "pattern": "^T\\d+$",
            "description": "Unique task identifier within request scope"
        },
        "parent_request_id": {
            "type": "string",
            "pattern": "^REQ-",
            "description": "Parent requirement package reference"
        },
        "title": {
            "type": "string",
            "maxLength": 120,
            "description": "Human-readable task title"
        },
        "objective": {
            "type": "string",
            "description": "What this task must achieve. One clear sentence."
        },
        "scope_in": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "description": "Explicitly included in this task's scope"
        },
        "scope_out": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Explicitly excluded from this task"
        },
        "constraints": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Technical, business, or quality constraints"
        },
        "allowed_tools": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Tools/commands the executor may use. Empty = no restriction."
        },
        "relevant_skills": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "path"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                    },
                    "reason": {
                        "type": "string"
                    }
                }
            },
            "description": "Skills from _rag_index recommended for this task"
        },
        "dependencies": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Task IDs that must complete before this task"
        },
        "expected_outputs": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "description": "Concrete deliverables: files, changes, artifacts"
        },
        "acceptance_checks": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "description": "Verifiable conditions that define 'done'"
        },
        "risk_level": {
            "enum": [
                "low",
                "medium",
                "high"
            ],
            "description": "Overall risk assessment"
        },
        "rollback_strategy": {
            "type": "string",
            "description": "How to undo this task if it fails or is rejected"
        },
        "evidence_required": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "description": "What evidence must be provided to prove completion"
        }
    }
}