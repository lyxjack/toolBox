{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ReworkOrder",
    "type": "object",
    "required": [
        "requirementRef",
        "reasonCode",
        "reasonLabel",
        "reworkTarget",
        "reworkIteration",
        "description"
    ],
    "properties": {
        "requirementRef": {
            "type": "string",
            "pattern": "^REQ-"
        },
        "reasonCode": {
            "type": "string",
            "pattern": "^(BUILD|REQ|BHV|ISO|EVD)-\\d{3}$",
            "description": "Structured error code"
        },
        "reasonLabel": {
            "type": "string"
        },
        "reworkTarget": {
            "enum": [
                "PM",
                "CTO",
                "EXECUTION"
            ]
        },
        "reworkIteration": {
            "type": "integer",
            "minimum": 1
        },
        "description": {
            "type": "string"
        },
        "evidence": {
            "type": "string",
            "description": "Reference to qa_report section"
        },
        "expectedBehavior": {
            "type": "string"
        },
        "actualBehavior": {
            "type": "string"
        },
        "affectedTasks": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "failureMemoryCandidate": {
            "type": "boolean"
        }
    }
}